{
  "name": "usage-ai",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && npm run check:version",
    "check:version": "node scripts/check-version.mjs",
    "check:pii": "node scripts/check-pii.mjs && cargo test -q -p usage-ai-app --lib pii_tripwire",
    "test": "vitest run",
    "test:watch": "vitest",
    "redact:codex": "node scripts/redact-codex.mjs",
    "redact:claude": "node scripts/redact-claude.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.2"
  }
}
