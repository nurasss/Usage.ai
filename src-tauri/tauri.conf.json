{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage.ai",
  "version": "1.0.0",
  "identifier": "com.nurasss.usageai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "Usage.ai",
      "width": 360,
      "height": 690,
      "minWidth": 360,
      "minHeight": 560,
      "maxWidth": 420,
      "resizable": true,
      "decorations": false,
      "transparent": true,
      "visible": false,
      "skipTaskbar": true,
      "alwaysOnTop": true,
      "focus": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": null, "signingIdentity": null }
  }
}
